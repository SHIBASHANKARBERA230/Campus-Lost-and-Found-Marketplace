<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvAdminDashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Admin Dashboard"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvAdminDashboardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Application overview and statistics"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvLastUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last updated: --"
            android:textSize="13sp"
            android:paddingStart="8dp"
            android:paddingBottom="16dp" />

        <!-- USERS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👥 USERS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvTotalUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👥 Total Users: 0"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvActiveUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 Active Users: 0"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvInactiveUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔴 Inactive Users: 0"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvAdminUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👑 Administrators: 0"
            android:textSize="18sp"
            android:padding="12dp" />

        <!-- ITEMS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 ITEMS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvTotalItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Total Items: 0"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvLostItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔴 Lost Items: 0"
            android:textSize="18sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvFoundItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 Found Items: 0"
            android:textSize="18sp"
            android:padding="12dp" />

        <!-- MODERATION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ MODERATION"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvPendingReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚩 Pending Reports: 0"
            android:textSize="18sp"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvPendingClaims"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Pending Claims: 0"
            android:textSize="18sp"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- QUICK ACTIONS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ QUICK ACTIONS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnManageReports"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="🚩 MANAGE REPORTS" />

        <Button
            android:id="@+id/btnManageClaims"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="⚠️ MANAGE CLAIMS" />

        <Button
            android:id="@+id/btnManageUsers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="👥 MANAGE USERS" />

        <Button
            android:id="@+id/btnActivityLog"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="📋 ACTIVITY LOG" />

        <!-- REFRESH -->

        <Button
            android:id="@+id/btnRefreshDashboard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="🔄 REFRESH DASHBOARD" />

    </LinearLayout>

</ScrollView>