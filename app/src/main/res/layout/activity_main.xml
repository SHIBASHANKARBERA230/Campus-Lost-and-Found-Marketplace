<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="48dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus Lost &amp; Found"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Find it. Report it. Return it."
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="👤 Profile"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ================= SEARCH ================= -->

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:hint="🔍  Search lost or found items"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp" />

        <!-- ================= BROWSE ITEMS ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Browse Items"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- ================= LOST / FOUND ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLostItems"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="🔴 LOST"
                android:textSize="13sp" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnFoundItems"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="🟢 FOUND"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ================= POST ITEM ================= -->

        <Button
            android:id="@+id/btnPostItem"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:minHeight="0dp"
            android:text="POST LOST / FOUND ITEM"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- ================= MY ITEMS ================= -->

        <Button
            android:id="@+id/btnMyItems"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:minHeight="0dp"
            android:text="👤 MY ITEMS"
            android:textSize="14sp" />

        <!-- ================= NOTIFICATIONS ================= -->

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:minHeight="0dp"
            android:text="🔔 NOTIFICATIONS"
            android:textSize="14sp" />

        <!-- ================= CLAIM REQUESTS ================= -->

        <Button
            android:id="@+id/btnClaimRequests"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:minHeight="0dp"
            android:text="@string/claim_requests"
            android:textSize="14sp" />

        <!-- ================= MY CLAIMS ================= -->

        <Button
            android:id="@+id/btnMyClaims"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:minHeight="0dp"
            android:text="📋 MY CLAIMS"
            android:textSize="14sp" />

        <!-- ================= RECENT ITEMS ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Recent Items"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- ================= NO RECENT ITEMS ================= -->

        <TextView
            android:id="@+id/tvNoRecentItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No items posted yet."
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- ================= DYNAMIC RECENT ITEMS ================= -->

        <LinearLayout
            android:id="@+id/recentItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>