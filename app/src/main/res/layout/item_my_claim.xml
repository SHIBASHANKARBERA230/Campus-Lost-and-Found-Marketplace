<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="#EEEEEE">

    <TextView
        android:id="@+id/tvMyClaimItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📦 Black Wallet"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMyClaimReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Reason: This is my wallet"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvMyClaimDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Details: Scratch on the back"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvMyClaimStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Status: PENDING ⏳"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMyClaimDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Claim ID: 1"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnViewMyClaimItem"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="VIEW ITEM" />

</LinearLayout>