<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 ADMIN ACTIVITY LOG"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="History of administrator actions"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:paddingBottom="8dp" />

    </LinearLayout>


    <!-- Filter Buttons -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <!-- First Row -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="ALL"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A4FB3"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnFilterUsers"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="USERS"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A4FB3"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnFilterReports"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="REPORTS"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A4FB3"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

        </LinearLayout>


        <!-- Second Row -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnFilterItems"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="ITEMS"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A4FB3"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnFilterSecurity"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="SECURITY"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A4FB3"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <!-- Empty space -->

            <View
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- Activity List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerActivityLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp" />

</LinearLayout>