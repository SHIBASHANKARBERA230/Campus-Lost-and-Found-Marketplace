<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.campuslostfound"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <permission
        android:name="com.example.campuslostfound.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.campuslostfound.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.CampusLostFound" >

        <!-- Splash Screen -->
        <activity
            android:name="com.example.campuslostfound.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name="com.example.campuslostfound.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register -->
        <activity
            android:name="com.example.campuslostfound.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main -->
        <activity
            android:name="com.example.campuslostfound.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lost Items -->
        <activity
            android:name="com.example.campuslostfound.LostItemsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Found Items -->
        <activity
            android:name="com.example.campuslostfound.FoundItemsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Item Details -->
        <activity
            android:name="com.example.campuslostfound.ItemDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Post Item -->
        <activity
            android:name="com.example.campuslostfound.PostItemActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Search Items -->
        <activity
            android:name="com.example.campuslostfound.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile -->
        <activity
            android:name="com.example.campuslostfound.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- My Items -->
        <activity
            android:name="com.example.campuslostfound.MyItemsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notifications -->
        <activity
            android:name="com.example.campuslostfound.NotificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.campuslostfound.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>